# ---------------------------------------------------------------------------
# Minecraft Server Manager — optional overrides
#
# This is a desktop app. It has no server mode and nothing here exposes it on a
# network; these variables only change where files live and how the app behaves
# on this machine.
#
# Copy to `.env` (or set them as real environment variables) to override.
# Every value is OPTIONAL — the defaults are correct for a normal install.
# ---------------------------------------------------------------------------

# Where your servers live. Default: <user data>/servers when installed,
# ./servers when running from source.
# MCSM_SERVERS_DIR=D:\minecraft\servers

# Registry, logs, backups and downloaded JDKs live here.
# MCSM_DATA_DIR=D:\minecraft\data

# Backup archives. Default: <data>/backups
# MCSM_BACKUPS_DIR=D:\minecraft\backups

# Where auto-downloaded JDKs are unpacked. Default: <data>/java
# MCSM_JDK_DIR=D:\minecraft\java

# Serve the interface from a folder instead of the bundled copy.
# Useful for a packaged install: point it at a checkout of `web/` and front-end
# changes appear without rebuilding and reinstalling the whole app.
# MCSM_WEB_DIR=C:\dev\minecraft-server-manager\web

# -- Resource tuning --------------------------------------------------------

# RAM (MiB) always left for the OS when sizing a server's heap.
# MCSM_RESERVED_RAM_MB=2048

# Hard ceiling (MiB) for any single server's -Xmx.
# MCSM_MAX_HEAP_MB=8192

# Allow fetching a JDK from Adoptium when a server needs one you do not have.
# MCSM_AUTO_DOWNLOAD_JAVA=false

# Extra directories to scan for JDKs (; separated).
# MCSM_EXTRA_JAVA_DIRS=C:\jdk;D:\tools\java

# Milliseconds between CPU/RAM samples. Minimum 1000.
# MCSM_STATS_INTERVAL_MS=2000

# Set to `production` to quieten request logging.
# NODE_ENV=production

# -- playit.gg tunnel agent -------------------------------------------------

# Pin a specific playit-agent release instead of the built-in default.
# Downloads are always verified against the publisher's Authenticode signature,
# so this only changes which reviewed version is fetched.
# MCSM_PLAYIT_VERSION=v1.2.0

# -- Diagnostics only -------------------------------------------------------
#
# The app talks to its own window over an ephemeral, loopback-only port guarded
# by a token generated fresh on every launch. These two exist so a diagnostic
# tool can attach to that transport; neither is needed for normal use.

# Pin the internal port instead of letting the OS choose one.
# MCSM_PORT=31415

# Print the transport log envelope (set automatically by `npm run app:debug`).
# MCSM_DEBUG_TRANSPORT=1
